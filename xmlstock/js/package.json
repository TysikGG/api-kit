{
  "name": "xmlstock",
  "version": "0.2.0",
  "description": "TypeScript/JavaScript client for XMLStock search engine API (Yandex XML, Google XML, and Wordstat)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:live": "jest --testPathPattern=test/live --testPathIgnorePatterns=/node_modules/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xmlstock",
    "yandex-xml",
    "google-xml",
    "wordstat",
    "serp",
    "search-api",
    "seo",
    "api-client",
    "sdk",
    "typescript"
  ],
  "author": "TysikGG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TysikGG/api-kit.git",
    "directory": "xmlstock/js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
