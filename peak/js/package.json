{
  "name": "peak-client",
  "version": "0.2.0",
  "description": "TypeScript client for the Peak CAPTCHA solving API (Cloudflare Turnstile, 5-second challenge, and AWS WAF)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --coverage",
    "test:live": "jest --testPathPattern=test/live --testPathIgnorePatterns=/node_modules/ --coverage=false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TysikGG/api-kit.git",
    "directory": "peak/js"
  },
  "keywords": [
    "peak",
    "turnstile",
    "cloudflare",
    "captcha",
    "turnstile-solver",
    "cf-challenge",
    "aws-waf"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
