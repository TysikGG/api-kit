{
  "name": "sv-number-client",
  "version": "0.1.0",
  "description": "TypeScript client for the SV Number SMS verification API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:live": "jest --testPathPattern=test/live --testPathIgnorePatterns=/node_modules/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TysikGG/api-kit.git",
    "directory": "sv-number/js"
  },
  "keywords": [
    "sv-number",
    "sms",
    "otp",
    "verification",
    "virtual-number",
    "sms-activate"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
